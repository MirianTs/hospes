API_PORT=4000
# Any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Arduino COM port (Device Manager > Ports, e.g. COM3), "auto" to detect it,
# or empty for mock mode (unlock commands are only logged).
ARDUINO_PORT=
ARDUINO_BAUD=9600

# face-api distance between the ID photo and the selfie; lower = stricter
FACE_MATCH_THRESHOLD=0.6
# demo = verification always succeeds (no photos stored); real = compare faces for real
FACE_VERIFICATION=demo
TIMEZONE=Asia/Tbilisi

# Optional, relative to backend/ (defaults shown)
# DB_PATH=data/hospes.db
# UPLOAD_DIR=uploads
